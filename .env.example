# Application
PORT=3000
SESSION_SECRET=remplace_par_une_chaine_aleatoire_longue

# PostgreSQL (base relationnelle)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vite_gourmand

# MongoDB (base non relationnelle, donnees analytiques)
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DB=vite_gourmand_analytics

# Connexions utilisees hors Docker (installation locale classique).
# Avec docker compose, ces deux URL sont construites automatiquement
# et pointent sur les services "db" et "mongo" du reseau Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vite_gourmand
MONGO_URL=mongodb://mongo:mongo@localhost:27017/vite_gourmand_analytics?authSource=admin
